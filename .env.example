# Ejemplo de variables de entorno para la aplicación
# Copia este archivo a `.env` y edítalo según tu entorno.

# URI de conexión a MongoDB (ejemplo local)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/obras

# Puerto en el que escucha la aplicación Spring Boot
SERVER_PORT=8080

# Perfil de Spring (opcional)
# SPRING_PROFILES_ACTIVE=local
